# --------------------------------------------
# 1️⃣ Base image - Python 공식 slim 버전 (용량↓)
# --------------------------------------------
FROM python:3.11-slim

# --------------------------------------------
# 2️⃣ 기본 OS 패키지 설치
# --------------------------------------------
RUN apt-get update && apt-get install -y \
    build-essential \
    default-libmysqlclient-dev \
    pkg-config \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --------------------------------------------
# 3️⃣ 컨테이너 내부 작업 경로 설정
# --------------------------------------------
WORKDIR /app

# --------------------------------------------
# 4️⃣ requirements.txt 복사 후 설치
# --------------------------------------------
COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# --------------------------------------------
# 5️⃣ 앱 전체 코드 복사
# --------------------------------------------
COPY . .

# --------------------------------------------
# 6️⃣ 환경 변수 기본값 설정 (.env로 덮어쓰기 가능)
# --------------------------------------------
ENV FLASK_APP=app.py \
    FLASK_ENV=development \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# --------------------------------------------
# 7️⃣ Flask 서버 실행 (eventlet 기반으로 SocketIO 지원)
# --------------------------------------------
CMD ["python", "app.py"]
